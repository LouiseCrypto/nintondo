{
  "name": "nintondo-web",
  "private": true,
  "type": "module",
  "engines": { "node": "20.x" },
  "scripts": {
    "build": "pnpm --filter miniapp build && node_modules/.bin/tsc -p tsconfig.shared.json",
    "dev": "pnpm --filter miniapp dev",
    "typecheck": "pnpm --filter miniapp typecheck && tsc --noEmit -p tsconfig.api.json"
  },
  "dependencies": {
    "@vercel/og": "^0.11.1",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  }
}
