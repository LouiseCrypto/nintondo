{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["api/_shared/**/*"]
}
